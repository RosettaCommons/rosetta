-constant_seed 1
-s 4s0v_and_suvorexant_only.pdb
-extra_res_fa test_params/suvorexant.params
-motif_filename 4S0V_motifs.motifs
-protein_discovery_locus 1
-input_ligand_residue A:2001
-input_ligand_skip_highresdock true
-collect_motifs_from_placed_ligand true
-space_fill_cutoff_score 0.0
-post_highresdock_fa_atr_rep_score true
-score_with_ligand_wts_function true
-fa_rep_cutoff 10000
-fa_atr_cutoff 10000
-fa_atr_rep_cutoff 10000
-ligand_wts_fxn_cutoff 10000
-ddg_cutoff 10000
-minimum_motifs_formed_cutoff 9999
-minimum_significant_motifs_formed_cutoff 0
-minimum_ratio_of_real_motifs_from_ligand 0
-output_motifs_as_pdb false
